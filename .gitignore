# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.angular/
.nest/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Prisma
apps/api/prisma/migrations/**/migration_lock.toml

# Docker volumes (local data)
pgdata/
mongodata/
redisdata/

# Temporary
tmp/
temp/
*.tmp

# Terraform (local state, cache, real tfvars — keep lock files in VCS)
**/.terraform/
*.tfstate
*.tfstate.*
**/terraform.tfvars
**/*.auto.tfvars
crash.log
crash.*.log
