# LLM (Gemini via OpenAI-compatible endpoint)
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# Embedding (pgvector / RAG)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://messenger:messenger@localhost:5432/messenger_hub

# MongoDB
MONGODB_URI=mongodb://messenger:messenger@localhost:27017/messenger_hub?authSource=admin

# Redis (BullMQ — queue/worker)
REDIS_HOST=localhost
REDIS_PORT=6379

# BullBoard (queue review UI) — mounted on the API process
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues
# Optional HTTP basic auth for the board
# BULL_BOARD_USERNAME=admin
# BULL_BOARD_PASSWORD=change-me

# App
PORT=3000
NODE_ENV=development

# CORS (allowed origin for the Angular dev server)
CORS_ORIGIN=http://localhost:4200

# Webhook default clinic (used when request body omits clinic_id)
# After `pnpm --filter api db:seed`, set this to one of the seeded clinic UUIDs
DEFAULT_CLINIC_ID=your-clinic-uuid
